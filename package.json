    "test:phase12": "node scripts/test-phase12.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:security": "npm run security:secrets && npm run security:env && npm run security:audit && npm run security:schema && npm run security:functions",
    "security:secrets": "node scripts/audit-secrets.mjs",
    "security:env": "node scripts/audit-client-env.mjs",
    "security:audit": "node scripts/audit-project-security.mjs",
    "security:schema": "node scripts/test-supabase-schema.mjs",
    "security:functions": "node scripts/test-edge-function-contracts.mjs",
    "test:all": "npm run lint && npm run test:recommendations && npm run test:phase10 && npm run test:phase11 && npm run test:phase12 && npm run test:phase13 && npm run test:unit && npm run test:security && npm run build",
    "test:phase13": "node scripts/test-phase13.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.2.1",
    "lucide-react": "^1.17.0",
