# Browser-safe Vite variables only.
# Copy this file to .env and replace the placeholders with values from
# Supabase Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Developer access is never controlled by browser variables.
# Approve accounts with Supabase Edge Function secrets instead:
# DEVELOPER_EMAILS and/or DEVELOPER_USER_IDS.
